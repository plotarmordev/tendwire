[Unit]
Description=Validate the frozen ACP live candidate for one uninterrupted hour
After=herdr-server.service tendwired.service herdres.service herdres-gateway.service
Requires=herdr-server.service tendwired.service herdres.service herdres-gateway.service

[Service]
Type=simple
UnsetEnvironment=LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH TAR_OPTIONS GIT_DIR GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CONFIG GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_COUNT HTTPS_PROXY HTTP_PROXY ALL_PROXY NO_PROXY https_proxy http_proxy all_proxy no_proxy SSL_CERT_FILE SSL_CERT_DIR REQUESTS_CA_BUNDLE CURL_CA_BUNDLE BASH_ENV ENV PYTHONPATH PYTHONHOME
Environment=PYTHONSAFEPATH=1
ExecStart=/home/smith/.local/share/acp-runtime/releases/9026d9bc-7446533-3659994/monitor-one-hour
Restart=no
